<?xml version="1.0" encoding="utf-8"?>
<!-- Sugarlicious near reimplementation of the information hierarchy of the former G6 Wear OS face. No Dexcom assets or branding are included. AGPL-3.0-or-later. -->
<WatchFace width="450" height="450" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="05:40:00" />
    <Scene backgroundColor="#FF000000">
        <PartDraw x="0" y="0" width="450" height="450">
            <RoundRectangle x="24" y="149" width="402" height="157" cornerRadiusX="10" cornerRadiusY="10">
                <Fill color="#FF111A27" />
                <Stroke color="#FF222A38" thickness="2" />
            </RoundRectangle>
        </PartDraw>

        <ComplicationSlot slotId="0" displayName="G6 style glucose" isCustomizable="FALSE" supportedTypes="SHORT_TEXT EMPTY" x="96" y="42" width="258" height="104">
            <DefaultProviderPolicy primaryProvider="app.aapswear/app.aapswear.complications.G6StyleHeaderComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="258" height="104" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="258" height="70">
                    <Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="60" weight="BOLD" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text>
                </PartText>
                <PartText x="0" y="68" width="258" height="31">
                    <Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="22" weight="BOLD" color="#FFF5F5F5"><Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template></Font></Text>
                </PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="1" displayName="G6 style glucose graph" isCustomizable="FALSE" supportedTypes="SMALL_IMAGE EMPTY" x="24" y="149" width="402" height="157">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy primaryProvider="app.aapswear/app.aapswear.complications.G6StyleGraphComplication" primaryProviderType="SMALL_IMAGE" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="402" height="157" />
            <Complication type="SMALL_IMAGE">
                <PartImage x="0" y="0" width="402" height="157"><Image resource="[COMPLICATION.SMALL_IMAGE]" /></PartImage>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <DigitalClock x="72" y="309" width="306" height="75">
            <TimeText x="0" y="0" width="306" height="75" format="hh:mm" hourFormat="SYNC_TO_DEVICE" align="CENTER">
                <Font family="SYNC_TO_DEVICE" size="62" weight="BOLD" color="#FFFFFFFF" />
            </TimeText>
        </DigitalClock>

        <ComplicationSlot slotId="2" displayName="G6 style source status" isCustomizable="FALSE" supportedTypes="SHORT_TEXT EMPTY" x="92" y="383" width="266" height="52">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy primaryProvider="app.aapswear/app.aapswear.complications.G6StyleStatusComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="266" height="52" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="266" height="28"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="18" weight="BOLD" color="#FFD9D7FF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText>
                <PartText x="0" y="25" width="266" height="23"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="12" color="#FFA8A8BA"><Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template></Font></Text></PartText>
            </Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
