<?xml version="1.0" encoding="utf-8"?>
<!-- AGPL-3.0-or-later. Declarative port of AndroidAPS CircleWatchface. -->
<WatchFace width="450" height="450">
    <Metadata key="CLOCK_TYPE" value="ANALOG" />
    <Metadata key="PREVIEW_TIME" value="10:08:00" />
    <Scene backgroundColor="#000000">
        <!-- AndroidAPS Circle uses the clock hands as gaps in a glucose-colored ring. -->
        <PartDraw x="10" y="10" width="430" height="430">
            <Arc centerX="215" centerY="215" width="405" height="405" startAngle="0" endAngle="360">
                <Stroke color="#FF62FF6B" cap="ROUND" thickness="15" />
            </Arc>
            <Arc centerX="215" centerY="215" width="405" height="405" startAngle="0" endAngle="16">
                <Transform target="startAngle" value="([HOUR_0_23] % 12) * 30 + [MINUTE] * 0.5 - 8" />
                <Transform target="endAngle" value="([HOUR_0_23] % 12) * 30 + [MINUTE] * 0.5 + 8" />
                <Stroke color="#FF000000" cap="BUTT" thickness="38" />
            </Arc>
            <Arc centerX="215" centerY="215" width="405" height="405" startAngle="0" endAngle="8">
                <Transform target="startAngle" value="[MINUTE] * 6 - 4" />
                <Transform target="endAngle" value="[MINUTE] * 6 + 4" />
                <Stroke color="#FF000000" cap="BUTT" thickness="38" />
            </Arc>
        </PartDraw>

        <ComplicationSlot slotId="0" displayName="Glucose age" isCustomizable="TRUE" supportedTypes="SHORT_TEXT EMPTY" x="155" y="85" width="140" height="55">
            <DefaultProviderPolicy primaryProvider="app.aapswear/app.aapswear.complications.GlucoseAgeComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="140" height="55" />
            <Complication type="SHORT_TEXT"><PartText x="0" y="5" width="140" height="45"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="30" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template></Font></Text></PartText></Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="1" displayName="Glucose" isCustomizable="TRUE" supportedTypes="SHORT_TEXT EMPTY" x="85" y="135" width="280" height="130">
            <DefaultProviderPolicy primaryProvider="app.aapswear/app.aapswear.complications.GlucoseComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="280" height="130" />
            <Complication type="SHORT_TEXT"><PartText x="0" y="0" width="280" height="125"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="100" weight="NORMAL" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TEXT]" /></Template></Font></Text></PartText></Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="2" displayName="AAPS status" isCustomizable="TRUE" supportedTypes="SHORT_TEXT EMPTY" x="70" y="260" width="310" height="52">
            <DefaultProviderPolicy primaryProvider="app.aapswear/app.aapswear.complications.AapsStatusComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="310" height="52" />
            <Complication type="SHORT_TEXT"><PartText x="0" y="4" width="310" height="43"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="25" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template></Font></Text></PartText></Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>

        <ComplicationSlot slotId="3" displayName="Glucose delta" isCustomizable="TRUE" supportedTypes="SHORT_TEXT EMPTY" x="90" y="310" width="270" height="58">
            <DefaultProviderPolicy primaryProvider="app.aapswear/app.aapswear.complications.GlucoseDeltaComplication" primaryProviderType="SHORT_TEXT" defaultSystemProvider="EMPTY" defaultSystemProviderType="EMPTY" />
            <BoundingBox x="0" y="0" width="270" height="58" />
            <Complication type="SHORT_TEXT"><PartText x="0" y="5" width="270" height="48"><Text align="CENTER" ellipsis="TRUE"><Font family="SYNC_TO_DEVICE" size="30" color="#FFFFFFFF"><Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template></Font></Text></PartText></Complication>
            <Complication type="EMPTY" />
        </ComplicationSlot>
    </Scene>
</WatchFace>
