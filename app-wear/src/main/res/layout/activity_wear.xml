<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="18dp"
            android:paddingEnd="30dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:contentDescription="@string/brand_logo"
                    android:src="@drawable/frediabetics_logo" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Sugarlicious"
                    android:textColor="@color/wear_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/wear_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:30"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/bg_wear_glucose"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="14dp">
                <TextView
                    android:id="@+id/wear_glucose"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/wear_green"
                    android:textSize="44sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/wear_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="keine Daten"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/wear_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="○ Keine Daten"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="82dp"
                android:layout_marginTop="7dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wear_tile"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TREND" android:textColor="@color/wear_text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/wear_trend" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/wear_text" android:textSize="28sp" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_wear_tile"
                    android:gravity="center"
                    android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DELTA" android:textColor="@color/wear_text_secondary" android:textSize="10sp" />
                    <TextView android:id="@+id/wear_delta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/wear_cyan" android:textSize="21sp" />
                    <TextView android:id="@+id/wear_age" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/wear_text_secondary" android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_wear_tile"
                android:orientation="vertical"
                android:padding="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VERBINDUNG" android:textColor="@color/wear_text_secondary" android:textSize="10sp" />
                <TextView android:id="@+id/wear_connection" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="○ Telefon nicht erreichbar" android:textColor="@color/wear_text_secondary" android:textSize="13sp" />
                <TextView android:id="@+id/wear_source" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:text="AndroidAPS nicht erkannt" android:textColor="@color/wear_text" android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/read_only"
                android:textColor="@color/wear_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
