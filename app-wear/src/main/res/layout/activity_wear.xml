<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/wear_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_background"
    tools:ignore="HardcodedText,MergeRootFrame,SmallSp,UselessParent">

    <ScrollView
        android:id="@+id/wear_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="12dp"
            android:paddingEnd="26dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wear_brand_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/brand_logo"
                    android:src="@drawable/ic_sugarlicious_monochrome"
                    android:tint="@color/wear_text" />

                <TextView
                    android:id="@+id/wear_brand_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="Sugarlicious"
                    android:textColor="@color/wear_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wear_clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="7dp"
                    android:text="10:30"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="10sp" />

                <ImageView
                    android:id="@+id/wear_settings"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Einstellungen"
                    android:padding="5dp"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/wear_text" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wear_glucose_card"
                android:layout_width="match_parent"
                android:layout_height="102dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GLUKOSE"
                        android:textColor="@color/wear_text_secondary"
                        android:textSize="8sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wear_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="6dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="2dp"
                        android:text="○ KEINE DATEN"
                        android:textColor="@color/wear_text_secondary"
                        android:textSize="7sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/wear_glucose"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:text="—"
                        android:textColor="@color/wear_text"
                        android:textSize="40sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/wear_trend_container"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="5dp"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/wear_trend_arrow_1"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:contentDescription="Trend"
                            android:src="@drawable/ic_trend_arrow"
                            android:tint="@color/wear_text" />

                        <ImageView
                            android:id="@+id/wear_trend_arrow_2"
                            android:layout_width="27dp"
                            android:layout_height="27dp"
                            android:layout_marginStart="1dp"
                            android:contentDescription="Trend"
                            android:src="@drawable/ic_trend_arrow"
                            android:tint="@color/wear_text"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/wear_delta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/wear_cyan"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wear_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="—"
                        android:textColor="@color/wear_text_secondary"
                        android:textSize="9sp" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/wear_unit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="keine Daten"
                        android:textColor="@color/wear_text_secondary"
                        android:textSize="9sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wear_basal_card"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="13dp"
                android:paddingEnd="13dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="BASAL"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wear_basal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textColor="@color/wear_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wear_therapy_row"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/wear_iob_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IOB"
                        android:textColor="@color/wear_text_secondary"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/wear_iob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/wear_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/wear_cob_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="3dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="COB"
                        android:textColor="@color/wear_text_secondary"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/wear_cob"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/wear_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wear_graph_card"
                android:layout_width="match_parent"
                android:layout_height="126dp"
                android:layout_marginTop="6dp"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="7dp"
                android:paddingEnd="8dp"
                android:paddingBottom="7dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GLUKOSEVERLAUF"
                        android:textColor="@color/wear_text"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/wear_history_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keine Historie"
                        android:textColor="@color/wear_text_secondary"
                        android:textSize="7sp" />
                </LinearLayout>

                <app.aapswear.wear.WearGlucoseChart
                    android:id="@+id/wear_glucose_chart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wear_connection_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="11dp"
                android:paddingTop="8dp"
                android:paddingEnd="11dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/wear_connection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="○ Telefon nicht erreichbar"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wear_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Datenquelle nicht bereit"
                    android:textColor="@color/wear_text"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/wear_sync_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tippen zum Aktualisieren"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/wear_watchface_push_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Watchface-Direktwechsel wird geprüft"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="7sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="9dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/wear_footer_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Sugarlicious"
                    android:src="@drawable/ic_sugarlicious_monochrome"
                    android:tint="@color/wear_text_secondary" />

                <TextView
                    android:id="@+id/wear_footer_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="by FreDiabetics"
                    android:textColor="@color/wear_text_secondary"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
