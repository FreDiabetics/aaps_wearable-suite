<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#17343C" />
            <stroke android:width="1dp" android:color="@color/app_cyan" />
            <corners android:radius="999dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_surface_high" />
            <stroke android:width="1dp" android:color="@color/app_border" />
            <corners android:radius="999dp" />
        </shape>
    </item>
</selector>
