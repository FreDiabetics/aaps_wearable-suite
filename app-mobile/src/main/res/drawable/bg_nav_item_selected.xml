<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/app_surface_raised"/>
            <corners android:radius="@dimen/radius_navigation"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/app_surface_selected"/>
            <corners android:radius="@dimen/radius_navigation"/>
        </shape>
    </item>
</selector>