<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/app_background" android:fitsSystemWindows="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="64dp" android:gravity="center_vertical" android:paddingHorizontal="8dp">
        <ImageButton android:id="@+id/menu_button" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_button" android:contentDescription="@string/menu" android:padding="12dp" android:src="@drawable/ic_menu"/>
        <ImageView android:id="@+id/brand_logo" android:layout_width="48dp" android:layout_height="48dp" android:contentDescription="@string/brand_logo" android:scaleType="fitCenter" android:src="@drawable/frediabetics_logo"/>
        <TextView android:id="@+id/app_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="@string/app_name" android:textColor="@color/app_text" android:textSize="21sp" android:textStyle="bold"/>
        <ImageView android:id="@+id/source_shield" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginStart="2dp" android:contentDescription="Datenquelle geschützt" android:padding="6dp" android:src="@drawable/ic_shield"/>
        <ImageButton android:id="@+id/more_button" android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_icon_button" android:contentDescription="@string/more" android:padding="12dp" android:src="@drawable/ic_more"/>
    </LinearLayout>
    <ScrollView android:id="@+id/dashboard_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
        <LinearLayout android:id="@+id/dashboard_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="12dp" android:paddingTop="2dp" android:paddingEnd="12dp" android:paddingBottom="12dp"/>
    </ScrollView>
    <LinearLayout android:id="@+id/bottom_navigation" android:layout_width="match_parent" android:layout_height="72dp" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:layout_marginBottom="6dp" android:background="@drawable/bg_nav" android:baselineAligned="false" android:gravity="center" android:orientation="horizontal" android:paddingTop="7dp" android:paddingBottom="5dp">
        <LinearLayout android:id="@+id/nav_overview" style="@style/NavItem"><ImageView android:id="@+id/nav_overview_icon" style="@style/NavIcon" android:src="@drawable/ic_home"/><TextView android:id="@+id/nav_overview_label" style="@style/NavLabel" android:text="@string/overview"/></LinearLayout>
        <LinearLayout android:id="@+id/nav_history" style="@style/NavItem"><ImageView android:id="@+id/nav_history_icon" style="@style/NavIcon" android:src="@drawable/ic_history"/><TextView android:id="@+id/nav_history_label" style="@style/NavLabel" android:text="@string/history"/></LinearLayout>
        <LinearLayout android:id="@+id/nav_data" style="@style/NavItem"><ImageView android:id="@+id/nav_data_icon" style="@style/NavIcon" android:src="@drawable/ic_data"/><TextView android:id="@+id/nav_data_label" style="@style/NavLabel" android:text="@string/data"/></LinearLayout>
        <LinearLayout android:id="@+id/nav_settings" style="@style/NavItem"><ImageView android:id="@+id/nav_settings_icon" style="@style/NavIcon" android:src="@drawable/ic_settings"/><TextView android:id="@+id/nav_settings_label" style="@style/NavLabel" android:text="@string/settings"/></LinearLayout>
    </LinearLayout>
</LinearLayout>
