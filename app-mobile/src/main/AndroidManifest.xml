<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <queries>
  <package android:name="info.nightscout.androidaps"/>
  <package android:name="info.nightscout.aapspumpcontrol"/>
  <package android:name="info.nightscout.aapsclient"/>
  <package android:name="info.nightscout.aapsclient2"/>
  <package android:name="info.nightscout.aapsclient3"/>
 </queries>
 <application android:theme="@style/AppTheme" android:label="AAPS Display Bridge" android:allowBackup="false" android:usesCleartextTraffic="false">
  <activity android:name=".MainActivity" android:exported="true"><intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter></activity>
  <receiver android:name=".AapsStatusReceiver" android:exported="true"><intent-filter><action android:name="info.nightscout.androidaps.status"/></intent-filter></receiver>
  <service android:name=".MobileDataLayerService" android:exported="true"><intent-filter><action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED"/><data android:scheme="wear" android:host="*" android:path="/aaps-display/v1/request"/></intent-filter></service>
 </application>
</manifest>
